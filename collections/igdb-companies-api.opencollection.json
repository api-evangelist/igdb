{
  "opencollection": "1.0.0",
  "info": {
    "name": "IGDB Companies API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Client-ID",
      "value": "{{Client-ID}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Companies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query companies",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.igdb.com/v4/companies"
          },
          "docs": "Query companies"
        },
        {
          "info": {
            "name": "Query involved companies",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.igdb.com/v4/involved_companies"
          },
          "docs": "Query involved companies"
        }
      ]
    }
  ],
  "bundled": true
}